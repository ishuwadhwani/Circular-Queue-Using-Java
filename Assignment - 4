
import java.util.Scanner;

public class CircularQueue {
    int[] queue;
    int front, rear, size;

    CircularQueue(int capacity) {
        queue = new int[capacity];
        size = capacity;
        front = -1;
        rear = -1;
    }

    void enqueue(int job) {
        if ((rear + 1) % size == front) {
            System.out.println("Print queue is full!");
            return;
        }

        if (front == -1) {
            front = 0;
        }

        rear = (rear + 1) % size;
        queue[rear] = job;
        System.out.println("Print job " + job + " added.");
    }

    void dequeue() {
        if (front == -1) {
            System.out.println("Print queue is empty!");
            return;
        }

        System.out.println("Print job " + queue[front] + " completed.");

        if (front == rear) {
            front = -1;
            rear = -1;
        } else {
            front = (front + 1) % size;
        }
    }

    void display() {
        if (front == -1) {
            System.out.println("Print queue is empty!");
            return;
        }

        System.out.print("Pending print jobs: ");
        int i = front;

        while (true) {
            System.out.print(queue[i] + " ");
            if (i == rear) {
                break;
            }
            i = (i + 1) % size;
        }

        System.out.println();
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter queue capacity: ");
        int capacity = sc.nextInt();

        CircularQueue cq = new CircularQueue(capacity);
        int choice;

        do {
            System.out.println("\n1. Add Print Job");
            System.out.println("2. Complete Print Job");
            System.out.println("3. Display Queue");
            System.out.println("4. Exit");
            System.out.print("Enter choice: ");
            choice = sc.nextInt();

            switch (choice) {
                case 1:
                    System.out.print("Enter print job ID: ");
                    cq.enqueue(sc.nextInt());
                    break;
                case 2:
                    cq.dequeue();
                    break;
                case 3:
                    cq.display();
                    break;
                case 4:
                    System.out.println("Exiting...");
                    break;
                default:
                    System.out.println("Invalid choice!");
            }
        } while (choice != 4);

        sc.close();
    }
}
